# Copy this file to .env (or set the variables in your host, e.g. Render > Environment).
# NEVER commit real values. .env is git-ignored. Only the NAMES and safe defaults live here.

# ---- Web search through your own SearXNG (no API key, no paid search service) ----
# Address of the SearXNG server. Trusted operator setting: http:// or https:// only.
SEARXNG_BASE_URL=http://127.0.0.1:8080
# Seconds to wait for SearXNG (0.5 to 15).
SEARXNG_TIMEOUT_SECONDS=5
# How many results to keep (1 to 8, default 5). The 128-token model can only read about 3 short snippets anyway.
SEARCH_RESULT_LIMIT=5
# Longest snippet kept, in characters (40 to 600).
MAX_SNIPPET_LENGTH=220

# ---- Only read by docker-compose.searxng.yml ----
# Secret key for SearXNG. Generate your own: openssl rand -hex 32   (leave empty here, never commit a real one)
SEARXNG_SECRET=
# Pin a SearXNG version from https://hub.docker.com/r/searxng/searxng/tags (pick a dated tag, never "latest").
SEARXNG_IMAGE_TAG=

# ---- File upload and format conversion (temporary files, no credentials) ----
# Folder for temporary uploads and converted files (default backend/file_store, git-ignored). Emptied at start-up.
ELVARN_FILE_STORE=
# Biggest upload in megabytes (default 5).
ELVARN_MAX_UPLOAD_MB=5
# How long files are kept, in seconds (default 3600 = 1 hour, minimum 30).
ELVARN_FILE_TTL_SECONDS=3600
# Total size of everything stored at once, in megabytes (default 20).
ELVARN_MAX_STORE_MB=20
# How many files one visitor may keep at once (default 20).
ELVARN_MAX_FILES_PER_VISITOR=20

# ---- Search service on Render (SearXNG behind a token gatekeeper, see search_service/README.md) ----
# Token sent as "Authorization: Bearer ..." to the search service. Same value as SEARCH_PROXY_TOKEN there.
# Only sent over https:// (or to localhost). Leave empty for a local SearXNG without a gatekeeper.
SEARXNG_AUTH_TOKEN=
# Set to 0 to disable the start-up "wake-up" ping of a remote search service (default on).
ELVARN_SEARCH_WAKEUP=1

# ---- Knowledge graph (Neo4j, see docker-compose.neo4j.yml) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# choose a strong password; the same value is used by docker-compose.neo4j.yml
NEO4J_PASSWORD=

# ---- RAG store (Chroma) and cache/memory (Redis), see docker-compose.stores.yml ----
CHROMA_HOST=localhost
CHROMA_PORT=8001
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# ---- Hosted knowledge service (knowledge_service/README.md). When set, the site asks it for the GraphRAG context and ignores local store settings. ----
KNOWLEDGE_URL=
KNOWLEDGE_TOKEN=

# Keep Wikipedia/project-note passages out of the hosted graph (they are served by Chroma); set this for the pipeline when it writes to a hosted graph.
GRAPH_REFERENCE_DOCS=1

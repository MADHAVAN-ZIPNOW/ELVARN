# deployment: weights-only models are committed on purpose
!deploy/models/**/*.pt

backend/data/raw_v2/
backend/data/cache_wikipedia/
backend/data/v2/
backend/data/cache_*/

# the template of environment variable NAMES (no secrets) is committed on purpose
!.env.example

# temporary uploaded / converted files (deleted at expiry)
backend/file_store/

# console logs of long runs and the generated RAG training data (rebuild with backend/data_tools/build_rag_dataset.py)
*.out
backend/data/rag_v1/


# knowledge graph: ingest logs and the inbox of downloaded official documents (Neo4j holds the data)
backend/data/kb_ingest.*
backend/data/kb_inbox/

# collected raw documents (court / DVAC PDFs), collector state and run logs: large, regenerable, and not ours to republish
backend/data/kb_raw/
backend/data/kb_state/
backend/data/collect_logs/
backend/data/train_logs/
backend/data/rag_kb_*/

# React frontend: dependencies are not committed, the built dist/ is (the Render build has no Node step)
frontend-react/node_modules/
.venv-gpu/

# chat / notes training sets and logs built by data_tools (rebuild with collect_chat_data.py, build_rag_dataset.py, build_chat_mix.py)
backend/data/chat_v1/
backend/data/chat_mix_*/
backend/data/rag_v2/
backend/data/rag_v3/
backend/data/*.log
backend/data/gpu_install*.log

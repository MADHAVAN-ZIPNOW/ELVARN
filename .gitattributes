# Never rewrite line endings of these: their byte-for-byte hash is checked when a model is loaded.
*.json -text
*.pt binary
*.png binary
*.gif binary
*.webp binary
*.svg -text

# search_service: shell scripts and the Dockerfile must keep LF line endings (they run in Linux)
search_service/*.sh text eol=lf
search_service/Dockerfile text eol=lf
search_service/*.py text eol=lf
search_service/*.yml text eol=lf

# knowledge_service and docker: built/run in Linux containers, so keep LF line endings
knowledge_service/* text eol=lf
docker/* text eol=lf

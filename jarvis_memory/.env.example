# Jarvis Memory: copy to .env for local use. On Render set these as environment variables. NEVER commit real values.

# Neon free Postgres: use the POOLED connection string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Shared secret the dashboard and the phone app send as X-Owner-Key. 16+ random characters (e.g. `openssl rand -hex 24`).
JM_OWNER_KEY=

JARVIS_OWNER_NAME=Madhavan
JARVIS_OWNER_EMAIL=madhavan.ai.research@gmail.com
JARVIS_OWNER_PHONE=9789607995
JARVIS_TIMEZONE=Asia/Kolkata

# Groq free tier (AI extraction). Without it memories are still saved, just without AI title/summary/tags.
GROQ_API_KEY=
JM_LLM_MODEL=qwen/qwen3.8-27b

# Optional
JM_ALLOWED_ORIGINS=
JM_RATE_LIMIT_PER_MINUTE=60
# Warn at 80% of this and flag "over" at 100%. Render's free instance is killed at 512 MB.
JM_RAM_LIMIT_MB=400
# Writes are refused above this size so the free database never hits its hard limit (Neon free is 0.5 GB; raise to 800 if yours is 1 GB).
JM_DB_SOFT_LIMIT_MB=400
